# Copy to .env.local (git-ignored) to override. Restart `yarn dev` after changing.
#
# Where the dev server proxies /api, /assets, /files to.
# Default (unset): the live site.
# VITE_PROXY_TARGET=https://erp.pranera.in
#
# Point at your local bench (`bench --site pranera.com serve --port=8001`)
# when testing backend code that is not deployed to erp.pranera.in yet:
# VITE_PROXY_TARGET=http://127.0.0.1:8001
